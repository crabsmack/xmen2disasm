# Never commit the game. Supply your own dump as xmen2.bin.
*.bin
*.md.rom
*.smd
*.gen
!build_tools/**

# Build outputs (regenerated by tools/build.py)
build/
*.p
*.lst
*.h

# Python
.venv/
__pycache__/
*.pyc

# Claude Code worktrees live inside the repo
.claude/worktrees/

# Emulator build outputs and big run artifacts (emu/coverage/ IS committed)
emu/bin/
emu/_src/
emu/core/_build/
emu/bizcore/_build/
!emu/bizcore/*.h
emu/runs/
*.log

# Notes about this machine (local paths, toolchains, kits): never published
CLAUDE.local.md
